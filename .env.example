# GiveMeJob! local development template.
# Copy to .env only when a development command explicitly requires it.
# Never put real values in this tracked example.

# Desktop development
APP_ENV=development
APP_VERSION=0.1.0
LOG_LEVEL=INFO

# Frozen snapshot export only.
# PostgreSQL is developer-only data tooling and is not part of the Windows app.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=givemejob-local
POSTGRES_DB=givemejob
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://postgres:givemejob-local@localhost:5432/givemejob
CATALOG_VERSION=1
CATALOG_SCHEMA_VERSION=1
CATALOG_OUTPUT_DIR=.artifacts/catalog

# Optional release-only demo credentials. The build works without them.
# Values belong in the protected GitHub Actions `release` environment and must
# be rate-limited, free-tier and billing-disabled: desktop binary contents are
# always extractable. PR CI must never receive these values.
GIVEMEJOB_GROQ_DEMO_KEY=
GIVEMEJOB_GEMINI_DEMO_KEY=
GIVEMEJOB_OPENROUTER_DEMO_KEY=
GIVEMEJOB_CEREBRAS_DEMO_KEY=

# Tauri updater signing. The private key and password never enter Git.
TAURI_SIGNING_PRIVATE_KEY=
TAURI_SIGNING_PRIVATE_KEY_PASSWORD=

# BYOK is not configured here. The installed app stores it in
# Windows Credential Manager.
