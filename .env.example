# Runtime
APP_ENV=development
APP_VERSION=0.1.0
LOG_LEVEL=INFO
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.0

# Fixed product scope; see docs/DECISIONS.md and config/product.json.
MVP_MARKET=remote-first-global-plus-cis
MVP_VERTICAL=it-digital
MVP_INTERFACE_LOCALE=ru
MVP_INDEX_LANGUAGES=multilingual
SKILL_CANONICAL_LANGUAGE=en
SKILL_TAXONOMY=ESCO
PROJECT_VISIBILITY=private
SOURCE_USER_AGENT=GiveMeJobBot/0.1 (+https://github.com/emmzde/GiveMeJob)
EMBEDDING_MODEL=intfloat/multilingual-e5-large
EMBEDDING_CACHE_DIR=

# Infrastructure
POSTGRES_USER=postgres
POSTGRES_PASSWORD=givemejob
POSTGRES_DB=givemejob
POSTGRES_PORT=5432
REDIS_PORT=6379
DATABASE_URL=postgresql+psycopg://postgres:givemejob@localhost:5432/givemejob
REDIS_URL=redis://localhost:6379/0

# Job sources
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
JOOBLE_API_KEY=

# LLM providers (all calls must go through LLMRouter in Phase 5)
GROQ_API_KEY=
GOOGLE_API_KEY=
CEREBRAS_API_KEY=
OPENROUTER_API_KEY=
COHERE_API_KEY=
